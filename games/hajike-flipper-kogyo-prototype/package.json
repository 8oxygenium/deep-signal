{
  "name": "hajike-flipper-kogyo",
  "productName": "弾け！フリッパー興業",
  "version": "1.0.0",
  "description": "弾け！フリッパー興業（Hajike! Flipper Kogyo）- 7演目の3Dピンボール",
  "author": "HANSODE / Takao Sugiyama",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "icon": "node scripts/make-icon.mjs",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run icon && npm run typecheck && npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "test:installer": "node scripts/test-installer.mjs",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "koffi": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.64.0",
    "three": "^0.186.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
